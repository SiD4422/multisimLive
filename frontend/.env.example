# Copy this file to .env.local for local development
# .env.local is gitignored and will NOT be committed to the repository

# Your Google Gemini API key — required for AI Diagnose / Chat / Explain features
# Get one free at: https://aistudio.google.com/app/apikey
# Without this, the AI features will call the hosted proxy at nodesimapp.com/api/gemini
GEMINI_API_KEY=your_gemini_api_key_here
