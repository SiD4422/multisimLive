rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function validCircuitFields(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.description is string && d.description.size() <= 500
          && d.category is string && d.category.size() >= 1 && d.category.size() <= 30
          && d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 50
          && d.componentCount is int && d.componentCount >= 1 && d.componentCount <= 2000
          && d.circuitData is string && d.circuitData.size() >= 1 && d.circuitData.size() <= 80000;
    }

    function validNewCircuit(d) {
      return d.keys().hasOnly([
            'name', 'description', 'category', 'authorName', 'authorUid',
            'componentCount', 'circuitData', 'views', 'createdAt'
          ])
          && validCircuitFields(d)
          && d.authorUid is string && d.authorUid == request.auth.uid
          && d.views == 0
          && d.createdAt == request.time;
    }

    function validOwnerCircuitUpdate(next, prev) {
      return next.keys().hasOnly([
            'name', 'description', 'category', 'authorName', 'authorUid',
            'componentCount', 'circuitData', 'views', 'createdAt', 'updatedAt'
          ])
          && validCircuitFields(next)
          && next.authorUid == prev.authorUid
          && next.createdAt == prev.createdAt
          && next.views == prev.views
          && (!('updatedAt' in next) || next.updatedAt == request.time);
    }

    match /circuits/{circuitId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && validNewCircuit(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validOwnerCircuitUpdate(request.resource.data, resource.data);
      allow delete: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;

      // Anonymous view counter isolated in subcollection so circuit docs stay owner-only
      match /meta/{docId} {
        allow read: if true;
        allow create: if docId == 'views'
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if docId == 'views'
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count is int
                      && resource.data.count is int
                      && request.resource.data.count == resource.data.count + 1;
        allow delete: if isSignedIn()
                      && get(/databases/$(database)/documents/circuits/$(circuitId)).data.authorUid == request.auth.uid;
      }
    }

    // Immutable 8-char alphanumeric short share links readable by Edge SSR & clients
    function validSharedCircuit(d, shortId) {
      return shortId.matches('^[A-Za-z0-9]{8}$')
          && d.keys().hasOnly([
            'id', 'name', 'componentCount', 'componentSummary',
            'circuitData', 'authorUid', 'createdAt'
          ])
          && d.id is string && d.id == shortId
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.componentCount is int && d.componentCount >= 1 && d.componentCount <= 2000
          && d.componentSummary is string && d.componentSummary.size() <= 180
          && d.circuitData is string && d.circuitData.size() >= 1 && d.circuitData.size() <= 160000
          && (d.authorUid == null || (isSignedIn() && d.authorUid == request.auth.uid))
          && d.createdAt == request.time;
    }

    match /sharedCircuits/{shortId} {
      allow read: if true;
      allow create: if validSharedCircuit(request.resource.data, shortId);
      allow update: if false;
      allow delete: if false;
    }

    // Per-user usage quota & profile state (prevents client privilege escalation of isPro)
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && (!('isPro' in request.resource.data) || request.resource.data.isPro == false);
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && (!('isPro' in request.resource.data) || request.resource.data.isPro == resource.data.isPro);
      allow delete: if false;

      // Private user cloud circuit saves (offline localStorage synced on sign-in)
      match /circuits/{circuitId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
                              && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly([
                                'id', 'name', 'compressed', 'componentCount', 'savedAt', 'updatedAt'
                              ])
                              && request.resource.data.id is string
                              && request.resource.data.id == circuitId
                              && request.resource.data.id.size() >= 1
                              && request.resource.data.id.size() <= 80
                              && request.resource.data.name is string
                              && request.resource.data.name.size() >= 1
                              && request.resource.data.name.size() <= 100
                              && request.resource.data.compressed is string
                              && request.resource.data.compressed.size() >= 1
                              && request.resource.data.compressed.size() <= 160000
                              && request.resource.data.componentCount is int
                              && request.resource.data.componentCount >= 0
                              && request.resource.data.componentCount <= 2000
                              && request.resource.data.savedAt is int
                              && request.resource.data.savedAt >= 0
                              && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
