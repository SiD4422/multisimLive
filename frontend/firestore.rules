rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function validCircuitFields(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.description is string && d.description.size() <= 500
          && d.category is string && d.category.size() >= 1 && d.category.size() <= 30
          && d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 50
          && d.componentCount is int && d.componentCount >= 1 && d.componentCount <= 2000
          && d.circuitData is string && d.circuitData.size() >= 1 && d.circuitData.size() <= 80000;
    }

    function validNewCircuit(d) {
      return d.keys().hasOnly([
            'name', 'description', 'category', 'authorName', 'authorUid',
            'componentCount', 'circuitData', 'views', 'createdAt'
          ])
          && validCircuitFields(d)
          && d.authorUid is string && d.authorUid == request.auth.uid
          && d.views == 0
          && d.createdAt == request.time;
    }

    function validOwnerCircuitUpdate(next, prev) {
      return next.keys().hasOnly([
            'name', 'description', 'category', 'authorName', 'authorUid',
            'componentCount', 'circuitData', 'views', 'createdAt', 'updatedAt'
          ])
          && validCircuitFields(next)
          && next.authorUid == prev.authorUid
          && next.createdAt == prev.createdAt
          && next.views == prev.views
          && (!('updatedAt' in next) || next.updatedAt == request.time);
    }

    match /circuits/{circuitId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && validNewCircuit(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validOwnerCircuitUpdate(request.resource.data, resource.data);
      allow delete: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;

      // Anonymous view counter isolated in subcollection so circuit docs stay owner-only
      match /meta/{docId} {
        allow read: if true;
        allow create: if docId == 'views'
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if docId == 'views'
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count is int
                      && resource.data.count is int
                      && request.resource.data.count == resource.data.count + 1;
        allow delete: if isSignedIn()
                      && get(/databases/$(database)/documents/circuits/$(circuitId)).data.authorUid == request.auth.uid;
      }
    }

    // Per-user usage quota & profile state (prevents client privilege escalation of isPro)
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && (!('isPro' in request.resource.data) || request.resource.data.isPro == false);
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && (!('isPro' in request.resource.data) || request.resource.data.isPro == resource.data.isPro);
      allow delete: if false;
    }
  }
}
